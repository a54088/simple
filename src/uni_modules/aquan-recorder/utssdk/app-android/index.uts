import UTSRecorderHelper from "com.aquan.recorder.UTSRecorderHelper";
import RecordFrameCallback from "com.aquan.recorder.RecordFrameCallback";
import RecordSliceInfo from "com.aquan.recorder.RecordSliceInfo";
import List from "java.util.List";
import Context from "android.content.Context";

// UTSAndroid 全局对象声明（由 uni-app 在编译时提供）
declare const UTSAndroid: {
  getUniActivity(): Context | null;
  getAppContext(): Context | null;
};



export interface RecordSliceInfoData {
  sliceData: ArrayBuffer;
  sliceIndex: number;
  sliceDuration: number;
  sliceSize: number;
  mimeType: string;
}

// 开始录音的选项
export interface StartOptions {
  frameSize?: number; // 目标帧大小（字节），默认 10240
}

// 回调函数类型定义
type OnStartCallback = () => void;
type OnPauseCallback = () => void;
type OnResumeCallback = () => void;
type OnStopCallback = (totalSliceCount: number, totalDuration: number, allSlices: RecordSliceInfoData[]) => void;
type OnFrameRecordedCallback = (sliceInfo: RecordSliceInfoData) => void;
type OnErrorCallback = (errorMsg: string) => void;
type OnInterruptionBeginCallback = () => void;
type OnInterruptionEndCallback = () => void;
type OnDecibelChangeCallback = (decibel: number) => void;

// 将 RecordSliceInfo 转换为 RecordSliceInfoData
function convertSliceInfo(slice: RecordSliceInfo): RecordSliceInfoData {
  const data = {
    sliceData: slice.getSliceData(),
    sliceIndex: slice.getSliceIndex() as number,
    sliceDuration: slice.getSliceDuration() as number,
    sliceSize: slice.getSliceSize() as number,
    mimeType: slice.getMimeType()
  };
  return data as RecordSliceInfoData;
}

// 将 List<RecordSliceInfo> 转换为 RecordSliceInfoData[]
function convertSliceList(allSlices: List<RecordSliceInfo>): RecordSliceInfoData[] {
  const slicesData: RecordSliceInfoData[] = [];
  const size = allSlices.size;
  for (let i: number = 0; i < size; i++) {
    const slice = allSlices.get(i);
    slicesData.push(convertSliceInfo(slice));
  }
  return slicesData;
}

/**
 * UTS 录音回调实现类（直接实现 Java 接口）
 */
class UTSRecordCallback implements RecordFrameCallback {
  private onStartCallback: OnStartCallback | null = null;
  private onPauseCallback: OnPauseCallback | null = null;
  private onResumeCallback: OnResumeCallback | null = null;
  private onStopCallback: OnStopCallback | null = null;
  private onFrameRecordedCallback: OnFrameRecordedCallback | null = null;
  private onErrorCallback: OnErrorCallback | null = null;
  private onInterruptionBeginCallback: OnInterruptionBeginCallback | null = null;
  private onInterruptionEndCallback: OnInterruptionEndCallback | null = null;
  private onDecibelChangeCallback: OnDecibelChangeCallback | null = null;

  setOnStart(callback: OnStartCallback | null): void {
    this.onStartCallback = callback;
  }

  setOnPause(callback: OnPauseCallback | null): void {
    this.onPauseCallback = callback;
  }

  setOnResume(callback: OnResumeCallback | null): void {
    this.onResumeCallback = callback;
  }

  setOnStop(callback: OnStopCallback | null): void {
    this.onStopCallback = callback;
  }

  setOnFrameRecorded(callback: OnFrameRecordedCallback | null): void {
    this.onFrameRecordedCallback = callback;
  }

  setOnError(callback: OnErrorCallback | null): void {
    this.onErrorCallback = callback;
  }

  setOnInterruptionBegin(callback: OnInterruptionBeginCallback | null): void {
    this.onInterruptionBeginCallback = callback;
  }

  setOnInterruptionEnd(callback: OnInterruptionEndCallback | null): void {
    this.onInterruptionEndCallback = callback;
  }

  setOnDecibelChange(callback: OnDecibelChangeCallback | null): void {
    this.onDecibelChangeCallback = callback;
  }

  // 实现 RecordFrameCallback 接口方法
  onStart(): void {
    if (this.onStartCallback) {
      this.onStartCallback();
    }
  }

  onRecordPaused(): void {
    if (this.onPauseCallback) {
      this.onPauseCallback();
    }
  }

  onRecordResumed(): void {
    if (this.onResumeCallback) {
      this.onResumeCallback();
    }
  }

  onRecordFinished(totalSliceCount: Number, totalDuration: Number, allSlices: List<RecordSliceInfo>): void {
    if (this.onStopCallback) {
      const count = totalSliceCount as number;
      const duration = totalDuration as number;
      const slicesData = convertSliceList(allSlices);
      this.onStopCallback(count, duration, slicesData);
    }
  }

  onFrameRecorded(sliceInfo: RecordSliceInfo): void {
    if (this.onFrameRecordedCallback) {
      this.onFrameRecordedCallback(convertSliceInfo(sliceInfo));
    }
  }

  onRecordError(errorMsg: string): void {
    if (this.onErrorCallback) {
      this.onErrorCallback(errorMsg);
    }
  }

  onInterruptionBegin(): void {
    if (this.onInterruptionBeginCallback) {
      this.onInterruptionBeginCallback();
    }
  }

  onInterruptionEnd(): void {
    if (this.onInterruptionEndCallback) {
      this.onInterruptionEndCallback();
    }
  }

  onDecibelChange(decibel: Number): void {
    if (this.onDecibelChangeCallback) {
      this.onDecibelChangeCallback(decibel as number);
    }
  }
}

export class UTSRecorder {
  private callback: UTSRecordCallback | null = null;

  constructor() {
    this.callback = new UTSRecordCallback();
  }

  /**
   * 开始录音
   * @param options 录音选项
   */
  start(options?: StartOptions): void {
    if (this.callback == null) {
      console.error("录音回调未初始化");
      return;
    }

    const frameSize = options?.frameSize ?? 10240;
    const frameSizeInt = Math.floor(frameSize) as number;
    
    const success = UTSRecorderHelper.start( this.callback, frameSizeInt);
    if (!success) {
      console.error("启动录音失败");
    }
  }

  pause(): void {
    UTSRecorderHelper.pause();
  }

  resume(): void {
    UTSRecorderHelper.resume();
  }

  stop(): void {
    UTSRecorderHelper.stop();
  }

  /**
   * 监听录音开始事件
   */
  onStart(callback: OnStartCallback): void {
    this.callback?.setOnStart(callback);
  }

  /**
   * 取消监听录音开始事件
   */
  offStart(): void {
    this.callback?.setOnStart(null);
  }

  /**
   * 监听录音暂停事件
   */
  onPause(callback: OnPauseCallback): void {
    this.callback?.setOnPause(callback);
  }

  /**
   * 取消监听录音暂停事件
   */
  offPause(): void {
    this.callback?.setOnPause(null);
  }

  /**
   * 监听录音继续事件
   */
  onResume(callback: OnResumeCallback): void {
    this.callback?.setOnResume(callback);
  }

  /**
   * 取消监听录音继续事件
   */
  offResume(): void {
    this.callback?.setOnResume(null);
  }

  /**
   * 监听录音停止事件
   */
  onStop(callback: OnStopCallback): void {
    this.callback?.setOnStop(callback);
  }

  /**
   * 取消监听录音停止事件
   */
  offStop(): void {
    this.callback?.setOnStop(null);
  }

  /**
   * 监听已录制完指定帧大小的文件事件
   */
  onFrameRecorded(callback: OnFrameRecordedCallback): void {
    this.callback?.setOnFrameRecorded(callback);
  }

  /**
   * 取消监听已录制完指定帧大小的文件事件
   */
  offFrameRecorded(): void {
    this.callback?.setOnFrameRecorded(null);
  }

  /**
   * 监听录音错误事件
   */
  onError(callback: OnErrorCallback): void {
    this.callback?.setOnError(callback);
  }

  /**
   * 取消监听录音错误事件
   */
  offError(): void {
    this.callback?.setOnError(null);
  }

  /**
   * 监听录音因为受到系统占用而被中断开始事件
   */
  onInterruptionBegin(callback: OnInterruptionBeginCallback): void {
    this.callback?.setOnInterruptionBegin(callback);
  }

  /**
   * 取消监听录音中断开始事件
   */
  offInterruptionBegin(): void {
    this.callback?.setOnInterruptionBegin(null);
  }

  /**
   * 监听录音中断结束事件
   */
  onInterruptionEnd(callback: OnInterruptionEndCallback): void {
    this.callback?.setOnInterruptionEnd(callback);
  }

  /**
   * 取消监听录音中断结束事件
   */
  offInterruptionEnd(): void {
    this.callback?.setOnInterruptionEnd(null);
  }

  /**
   * 监听声音分贝变化事件
   */
  onDecibelChange(callback: OnDecibelChangeCallback): void {
    this.callback?.setOnDecibelChange(callback);
  }

  /**
   * 取消监听声音分贝变化事件
   */
  offDecibelChange(): void {
    this.callback?.setOnDecibelChange(null);
  }

  /**
   * 销毁资源
   */
  destroy(): void {
    UTSRecorderHelper.destroy();
    this.callback = null;
  }
}

// 导出实例（供直接使用的情况）
export const utsRecorder = new UTSRecorder();