{
  "pages": [
    //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
    {
      "path": "pages/home/index",
      "aliasPath": "/",
      "style": {
        "animationType": "fade-in",
        "animationDuration": 300,
        "navigationStyle": "custom",
        "navigationBarTitleText": "首页",
        "disableScroll": true,
        "backgroundColor": "#fff",
        "app-plus": {
          "bounce": "none"
        }
      }
    }
  ],
  "subPackages": [
    {
      "root": "pages-im",
      "name": "pagesIm",
      "pages": [
        {
          "path": "index",
          "style": {
            "animationType": "fade-in",
            "animationDuration": 300,
            "navigationBarTitleText": "IM",
            "navigationStyle": "custom"
          }
        }
        // {
        //   "path": "chat-list/index",
        //   "style": {
        //     "animationType": "fade-in",
        //     "animationDuration": 300,
        //     "navigationBarTitleText": "聊天列表",
        //     "navigationStyle": "custom"
        //   }
        // },
        // {
        //   "path": "chat/index",
        //   "style": {
        //     "navigationBarTitleText": "聊天",
        //     "navigationStyle": "custom"
        //   }
        // },
        // {
        //   "path": "contacts/index",
        //   "style": {
        //     "navigationBarTitleText": "联系人",
        //     "navigationStyle": "custom"
        //   }
        // },
      ]
    },
    {
      "root": "devTools/page",
      "name": "devToolsPage",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationStyle": "custom",
            // #ifdef APP-PLUS
            "softinputMode": "adjustResize",
            "backgroundColor": "transparent",
            "animationDuration": 1,
            "animationType": "none",
            "popGesture": "none",
            "bounce": "none",
            "titleNView": false,
            // #endif
            "app-plus": {
              "usingComponents": true,
              "nvueCompiler": "uni-app",
              "nvueStyleCompiler": "uni-app",
              "compilerVersion": 3
            }
          }
        }
      ]
    },
    {
      "root": "pages-sub",
      "pages": [
        {
          "path": "login/index",
          "style": {
            "navigationStyle": "custom"
          }
        },
        {
          "path": "map/index",
          "style": {
            "navigationBarTitleText": "地图模式",
            "navigationStyle": "custom"
          }
        }
      ]
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "啊圈",
    "navigationBarBackgroundColor": "#F8F8F8",
    "backgroundColor": "#F8F8F8"
  },
