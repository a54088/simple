  //   "selectedColor": "#FF612F",
  //   "backgroundColor": "#fff"
  // },
  "easycom": {
    "autoscan": true,
    "custom": {}
  },
	"condition" : { //模式配置，仅开发期间生效
		"current": 0, //当前激活的模式(list 的索引项)
		"list": [
			{
				"name": "地图", //模式名称
				"path": "pages-sub/map/index", //启动页面，必选
				"query": "" //启动参数，在页面的onLoad函数里面得到
			}
		]
	}
