<template>
  <view class="social-feed-container">
    <swiper 
      class="main-swiper" 
      vertical 
      :indicator-dots="false" 
      :autoplay="false" 
      :circular="true"
      :interval="3000"
      :duration="300"
      @change="onSlideChange"
      :current="currentIndex"
      :style="{ height: swiperHeight + 'px' }"
    >
      <swiper-item v-for="(item, index) in feedList" :key="item.id">
        <view class="feed-item">
          <!-- 媒体内容容器 -->
          <view class="media-container">
            <!-- 图片轮播 -->
            <template v-if="item.type === 'image'">
              <swiper 
                v-if="item.images && item.images.length > 1"
                class="image-swiper"
                :indicator-dots="false"
                :autoplay="false"
                :circular="true"
                @change="(e) => onImageSlideChange(index, e)"
                :current="getFeedItemState(index).currentImageIndex"
              >
                <swiper-item v-for="(img, imgIndex) in item.images" :key="imgIndex">
                  <image :src="img" mode="aspectFill" class="media-image" @click="handleImageClick(index, imgIndex)" />
                </swiper-item>
              </swiper>
              <image 
                v-else 
                :src="item.image || (item.images && item.images[0])" 
                mode="aspectFill" 
                class="media-image single-image"
                @click="handleImageClick(index, 0)"
              />
              
              <!-- 图片指示器 -->
              <view 
                v-if="item.images && item.images.length > 1" 
                class="image-indicator"
              >
                <view class="indicator-dots">
                  <view 
                    v-for="(_, dotIndex) in item.images" 
                    :key="dotIndex"
                    class="indicator-dot"
                    :class="{ 'active': dotIndex === (getFeedItemState(index).currentImageIndex || 0) }"
                  ></view>
                </view>
              </view>
            </template>
            
            <!-- 视频播放器 -->
            <template v-else-if="item.type === 'video'">
              <view class="video-container">
                <video 
                  :id="'video-' + index"
                  :src="item.video" 
                  :controls="false"
                  :show-center-play-btn="false"
                  :enable-play-gesture="true"
                  :loop="true"
                  :muted="getFeedItemState(index).isMuted"
                  class="media-video"
                  @loadeddata="onVideoLoaded(index)"
                  @timeupdate="onVideoTimeUpdate(index, $event)"
                  @error="onVideoError(index)"
                />
                
                <!-- 视频控制层 -->
                <view 
                  class="video-controls-overlay"
                  @click="toggleVideoPlayState(index)"
                >
                  <!-- 播放/暂停按钮 -->
                  <view 
                    v-if="!getFeedItemState(index).isPlaying" 
                    class="play-btn"
                  >
                    <text class="iconfont icon-bofang2" style="font-size: 120rpx; color: #fff;"></text>
                  </view>
                  
                  <!-- 静音/音量按钮 -->
                  <view 
                    class="mute-btn"
                    @click.stop="toggleMute(index)"
                  >
                    <text 
                      :class="getFeedItemState(index).isMuted ? 'iconfont icon-jingyin' : 'iconfont icon-shengyin'"
                      style="font-size: 48rpx; color: #fff;"
                    ></text>
                  </view>
                  
                  <!-- 视频进度条 -->
                  <view 
                    class="video-progress-overlay" 
                    v-if="getFeedItemState(index).duration > 0"
                  >
                    <view class="progress-bar-overlay">
                      <view 
                        class="progress-fill-overlay" 
                        :style="{ width: getFeedItemState(index).progress + '%' }"
                      ></view>
                    </view>
                  </view>
                </view>
              </view>
            </template>
          </view>
          
          <!-- 右侧交互按钮 -->
          <view class="right-actions">
            <!-- 头像 -->
            <view class="action-item avatar-item" @click="handleAvatarClick(item)">
              <image :src="item.userAvatar" mode="aspectFill" class="avatar-img" />
              <view class="follow-btn">
                <image src="/static/images/social/add.svg" style="width: 48rpx; height: 48rpx;" />
              </view>
            </view>
            
            <!-- 点赞 -->
            <view class="action-item" @click="handleLike(item, index)">
              <view class="action-icon" :class="{ 'liked': getFeedItemState(index).isLiked }">
                <text class="iconfont icon-dianzan-2" style="font-size: 52rpx;"></text>
              </view>
              <text class="action-count">{{ formatCount(getFeedItemState(index).likeCount) }}</text>
            </view>
            
            <!-- 评论 -->
            <view class="action-item" @click="handleComment(item, index)">
              <view class="action-icon">
                <image src="/static/images/social/pinglun.svg" style="width: 52rpx; height: 52rpx;" />
              </view>
              <text class="action-count">{{ formatCount(item.commentCount) }}</text>
            </view>
            
            <!-- 分享 -->
            <view class="action-item" @click="handleShare(item, index)">
              <view class="action-icon">
                <text class="iconfont icon-weixuanzhong" style="font-size: 52rpx;"></text>
              </view>
              <text class="action-count">{{ formatCount(item.shareCount) }}</text>
            </view>
            
            <!-- 更多 -->
            <view class="action-item" @click="handleMore(item, index)">
              <view class="action-icon">
                <text class="iconfont icon-gengduo-2" style="font-size: 52rpx;"></text>
              </view>
            </view>
          </view>
          
          <!-- 底部信息 -->
          <view class="bottom-info">
            <!-- 位置信息 -->
            <view class="location-info" v-if="item.location">
              <text class="iconfont icon-paizhao-dingwei" style="font-size: 24rpx; margin-right: 8rpx;"></text>
              <text class="location-text">{{ item.location }}</text>
            </view>
            
            <!-- 用户信息 -->
            <view class="user-info">
              <text class="username">@{{ item.username }}</text>
              <text class="time">{{ item.time }}</text>
            </view>
            
            <!-- 描述文字 -->
            <view class="description" v-if="item.description">
              <text class="desc-text" :class="{ 'expanded': getFeedItemState(index).isExpanded }">
                {{ item.description }}
              </text>
              <text 
                v-if="item.description && item.description.length > 50" 
                class="expand-btn"
                @click="toggleExpand(item, index)"
              >
                {{ getFeedItemState(index).isExpanded ? '收起' : '展开' }}
                <text class="iconfont icon-xiala" style="font-size: 20rpx; margin-left: 4rpx;"></text>
              </text>
            </view>
          </view>
        </view>
      </swiper-item>
    </swiper>
  </view>
</template>

<script>
import { useImgAndVideo } from '../hook/useImgAndVideo.js'

export default {
  name: 'SocialFeed',
  props: {
    feedList: {
      type: Array,
      required: true
    }
  },
  setup(props) {
    const {
      currentIndex,
      swiperHeight,
      onSlideChange,
      formatCount,
      handleLike,
      handleComment,
      handleShare,
      handleMore,
      handleAvatarClick,
      handleImageClick,
      toggleExpand,
      onImageSlideChange,
      getFeedItemState,
      onVideoTimeUpdate,
      onVideoLoaded,
      toggleVideoPlayState,
      onVideoError
    } = useImgAndVideo(props.feedList)
    
    // 切换静音状态
    const toggleMute = (index) => {
      const state = getFeedItemState(index)
      state.isMuted = !state.isMuted
      
      // 更新视频静音状态
      try {
        const videoContext = uni.createVideoContext(`video-${index}`)
        if (state.isMuted) {
          videoContext.pause()
        } else {
          videoContext.play()
        }
      } catch (error) {
        console.error('切换静音状态失败:', error)
      }
    }
    
    return {
      currentIndex,
      swiperHeight,
      onSlideChange,
      formatCount,
      handleLike,
      handleComment,
      handleShare,
      handleMore,
      handleAvatarClick,
      handleImageClick,
      toggleExpand,
      onImageSlideChange,
      getFeedItemState,
      onVideoTimeUpdate,
      onVideoLoaded,
      toggleVideoPlayState,
      onVideoError,
      toggleMute
    }
  }
}
</script>

<style scoped lang="scss">
.social-feed-container {
  width: 100%;
  height: 100%;
  position: relative;
  overflow: hidden;
}

.main-swiper {
  width: 100%;
  height: 100%;
}

.feed-item {
  width: 100%;
  height: 100%;
  position: relative;
}

.media-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.image-swiper,
.media-image {
  width: 100%;
  height: 100%;
}

.media-image {
  object-fit: cover;
}

.single-image {
  width: 100%;
  height: 100%;
}

.image-indicator {
  position: absolute;
  bottom: 40rpx;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  z-index: 5;
  
  .indicator-dots {
    display: flex;
    gap: 8rpx;
    align-items: center;
    
    .indicator-dot {
      width: 10rpx;
      height: 10rpx;
      border-radius: 50%;
      background-color: rgba(255, 255, 255, 0.5);
      transition: all 0.3s ease;
      
      &.active {
        width: 30rpx;
        border-radius: 5rpx;
        background-color: #fff;
      }
    }
  }
}

.video-container {
  position: relative;
  width: 100%;
  height: 100%;
}

.media-video {
  width: 100%;
  height: 100%;
}

.video-controls-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 100;
  pointer-events: none;
  
  .play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: auto;
  }
  
  .mute-btn {
    position: absolute;
    right: 32rpx;
    bottom: 120rpx;
    pointer-events: auto;
  }
  
  .video-progress-overlay {
    position: absolute;
    bottom: 40rpx;
    left: 32rpx;
    right: 32rpx;
    z-index: 5;
    pointer-events: auto;
    
    .progress-bar-overlay {
      height: 4rpx;
      background: rgba(255, 255, 255, 0.3);
      border-radius: 2rpx;
      overflow: hidden;
      margin-bottom: 12rpx;
      
      .progress-fill-overlay {
        height: 100%;
        background: #fff;
        border-radius: 2rpx;
        transition: width 0.1s linear;
      }
    }
  }
}

.right-actions {
  position: absolute;
  right: 32rpx;
  bottom: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40rpx;
  z-index: 200;
  
  .action-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8rpx;
    
    &.avatar-item {
      position: relative;
      
      .avatar-img {
        width: 96rpx;
        height: 96rpx;
        border-radius: 50%;
        border: 4rpx solid #fff;
      }
      
      .follow-btn {
        position: absolute;
        bottom: -28rpx;
        right: 20rpx;
      }
    }
    
    .action-icon {
      width: 96rpx;
      height: 96rpx;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      
      &.liked {
        color: #FF194A;
      }
    }
    
    .action-count {
      font-size: 24rpx;
      color: #fff;
      text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
    }
  }
}

.bottom-info {
  position: absolute;
  bottom: 0;
  left: 0;
  width: calc(100% - 120rpx);
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
  z-index: 200;
  
  .location-info {
    display: flex;
    align-items: center;
    margin-bottom: 16rpx;
    
    .location-text {
      font-size: 24rpx;
      color: #fff;
    }
  }
  
  .user-info {
    display: flex;
    align-items: center;
    gap: 16rpx;
    margin-bottom: 16rpx;
    
    .username {
      font-size: 28rpx;
      color: #fff;
      font-weight: 600;
    }
    
    .time {
      font-size: 24rpx;
      color: rgba(255, 255, 255, 0.8);
    }
  }
  
  .description {
    font-size: 28rpx;
    color: #fff;
    line-height: 1.6;
    
    .desc-text {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-overflow: ellipsis;
      
      &.expanded {
        display: block;
        -webkit-line-clamp: unset;
        line-clamp: unset;
      }
    }
    
    .expand-btn {
      color: rgba(255, 255, 255, 0.9);
      font-size: 24rpx;
      margin-left: 8rpx;
      display: inline-flex;
      align-items: center;
    }
  }
}
</style>