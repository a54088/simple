<template>
	<view class="content-wrapper">
		<swiper class="main-swiper" vertical :current="currentIndex"
			:style="{ width: swiperWidth + 'px' , height: swiperHeight + 'px' }" @change="handleSwiperChange">
			<swiper-item v-for="(item, index) in feedList" :key="item.id"
				:style="{ width: swiperWidth + 'px' , height: swiperHeight + 'px' }">
				<view class="feed-item" :style="{ width: swiperWidth + 'px' , height: swiperHeight + 'px' }">
					<!-- 媒体区域 -->
					<view class="media-container">
						<!-- 多图 -->
						<template v-if="item.type === 'image' && item.images && item.images.length > 1">
							<swiper :indicator-dots="false" :autoplay="false" circular
								@change="(e) => handleImageSwiperChange(index, e)"
								:current="getFeedItemState(index).currentImageIndex"
								:style="{ width: swiperWidth + 'px' , height: swiperHeight + 'px' }">
								<swiper-item v-for="(img, imgIndex) in item.images" :key="imgIndex"
									:style="{ width: swiperWidth + 'px' , height: swiperHeight + 'px' }">
									<view  class="images-container" :style="{ width: swiperWidth + 'px' , height: swiperHeight + 'px' }">
									<image :src="img" mode="widthFix" class="media-image"
										@click="handleImageClick(index, imgIndex)"
										:style="{ width: swiperWidth + 'px' , height: swiperHeight + 'px' }" />
									</view>
								</swiper-item>
							</swiper>
							<view class="image-indicator">
								<view class="indicator-dots">
									<view v-for="(_, dotIndex) in item.images" :key="dotIndex" class="indicator-dot"
										:class="{ 'active': dotIndex === (getFeedItemState(index).currentImageIndex || 0) }" />
								</view>
							</view>
						</template>

						<!-- 单图 -->
						<template v-else-if="item.type === 'image'">
							<view  class="images-container" :style="{ width: swiperWidth + 'px' , height: swiperHeight + 'px' }">
								<image :src="item.image || (item.images && item.images[0])" mode="widthFix"
									class="media-image" @click="handleImageClick(index, 0)"
									:style="{ width: swiperWidth + 'px' , height: swiperHeight + 'px' }" />
							</view>

						</template>

						<!-- 视频 -->
						<template v-else-if="item.type === 'video'">
							<view class="video-container">
								<video :id="`video-${index}`" :src="item.video" :loop="true" :controls="false"
									:show-center-play-btn="false" :enable-play-gesture="true"
									:autoplay="false" playsinline
									webkit-playsinline="true" x5-playsinline="true" x5-video-player-type="h5"
									x5-video-player-fullscreen="false" x5-video-orientation="portrait"
									object-fit="cover" enable-progress-gesture="false" show-bottom-progress="false"
									class="media-video" @loadeddata="onVideoLoaded(index)"
									@timeupdate="onVideoTimeUpdate(index, $event)" @error="onVideoError(index)"
									:style="{ width: swiperWidth + 'px' , height: swiperHeight + 'px' }" />

								<view class="video-controls-overlay" @click="toggleVideoPlayState(index)">
									<view v-if="!getFeedItemState(index).isPlaying" class="play-btn">
										<text class="iconfont icon-bofang2"
											style="font-size: 120rpx; color: #fff;"></text>
									</view>

									<view class="mute-btn" @click.stop="toggleMute(index)">
										<text
											:class="getFeedItemState(index).isMuted ? 'iconfont icon-jingyin' : 'iconfont icon-shengyin'"
											style="font-size: 48rpx; color: #fff;"></text>
									</view>

									<view v-if="getFeedItemState(index).duration > 0" class="video-progress-overlay">
										<view class="progress-bar-overlay">
											<view class="progress-fill-overlay"
												:style="{ width: getFeedItemState(index).progress + '%' }"></view>
										</view>
										<view class="progress-time">
											<text>{{ formatTime(getFeedItemState(index).currentTime) }}</text>
											<text>{{ formatTime(getFeedItemState(index).duration) }}</text>
										</view>
									</view>
								</view>
							</view>
						</template>
					</view>

					<!-- 右侧互动 -->
					<view class="right-actions">
						<view class="action-item avatar-item" @click="handleAvatarClick(item)">
							<image :src="item.userAvatar" mode="aspectFill" class="avatar-img" />
							<view class="follow-btn">
								<image src="/static/images/social/icon-add.png" style="width: 48rpx; height: 48rpx;" />
							</view>
						</view>

						<view class="action-item" @click="handleLike(item, index)">
							<view class="action-icon" :class="{ liked: getFeedItemState(index).isLiked }">
							<image src="/static/images/social/icon-heart.png" style="width: 52rpx; height: 52rpx;" />
							</view>
							<text class="action-count">{{ formatCount(getFeedItemState(index).likeCount) }}</text>
						</view>

						<view class="action-item" @click="handleComment(item, index)">
							<view class="action-icon">
								<image src="/static/images/social/icon-pinglun.png" style="width: 52rpx; height: 52rpx;" />
							</view>
							<text class="action-count">{{ formatCount(item.commentCount) }}</text>
						</view>

						<view class="action-item" @click="handleShare(item, index)">
							<view class="action-icon">
								<image src="/static/images/social/icon-share.png" style="width: 52rpx; height: 52rpx;" />
							</view>
							<text class="action-count">{{ formatCount(item.shareCount) }}</text>
						</view>

						<view class="action-item" @click="handleMore(item, index)">
							<view class="action-icon">
								<image src="/static/images/social/icon-more.png" style="width: 52rpx; height: 52rpx;" />
							</view>
						</view>
					</view>

					<!-- 底部信息 -->
					<view class="bottom" :style="{ paddingBottom: (safeAreaInsetBottom + 32) + 'px' }">
						<view class="bottom-info">
							<view class="location-info" v-if="item.location">
								<image src="/static/images/social/icon-location.png" style="width: 44rpx; height: 44rpx;" />
								<text class="location-text">{{ item.location }}</text>
							</view>

							<view class="user-info">
								<text class="username">@{{ item.username }}</text>
								<text class="time">{{ item.time }}</text>
							</view>

							<view class="description" v-if="item.description" :style="{ width: (swiperWidth - 64) + 'px'}">
								<text class="desc-text" :lines="getFeedItemState(index).isExpanded ? 0 : 2"
									:class="{ expanded: getFeedItemState(index).isExpanded }">
									{{ item.description }}
								</text>
								<text v-if="item.description && item.description.length > 50" class="expand-btn"
									@click="toggleExpand(item, index)">
									{{ getFeedItemState(index).isExpanded ? '收起' : '展开' }}
									<text class="iconfont icon-xiala"
										style="font-size: 20rpx; margin-left: 4rpx;"></text>
								</text>
							</view>
						</view>
					</view>
				</view>
			</swiper-item>
		</swiper>
	</view>
</template>

<script setup>

	import {
		useImgAndVideo
	} from '../hook/useImgAndVideo.js'

	const props = defineProps({
		feedList: {
			type: Array,
			required: true
		}
	})

	const formatTime = (seconds) => {
		if (!seconds || isNaN(seconds)) return '00:00'
		const mins = Math.floor(seconds / 60)
		const secs = Math.floor(seconds % 60)
		return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`
	}

	const {
		currentIndex,
		swiperWidth,
		swiperHeight,
		onSlideChange,
		formatCount,
		handleLike,
		handleComment,
		handleShare,
		handleMore,
		handleAvatarClick,
		handleImageClick,
		toggleExpand,
		onImageSlideChange,
		getFeedItemState,
		onVideoTimeUpdate,
		onVideoLoaded,
		toggleVideoPlayState
	} = useImgAndVideo(props.feedList)

	const safeAreaInsetBottom = uni.getSystemInfoSync()?.safeAreaInsets?.bottom || 0

	const handleSwiperChange = (event) => {
		onSlideChange(event)
	}

	const handleImageSwiperChange = (feedIndex, event) => {
		onImageSlideChange(feedIndex, event)
	}

	const toggleMute = (index) => {
		const state = getFeedItemState(index)
		state.isMuted = !state.isMuted
		try {
			const videoContext = uni.createVideoContext(`video-${index}`)
			if (state.isMuted) {
				videoContext.pause()
				state.isPlaying = false
			} else {
				videoContext.play()
				state.isPlaying = true
			}
		} catch (error) {
			console.error('切换静音失败', error)
		}
	}

	const onVideoError = (index) => {
		console.error('视频加载失败:', index)
	}
</script>

<style scoped>
	
	.content-wrapper {
		position: relative;
	}

	.main-swiper {
		width: 100%;
		height: 100%;
	}

	.feed-item {
		position: relative;
		justify-content: center;
		align-items: center;
	}

	.media-container {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 1;
	}

	.image-swiper,
	.media-image,
	.media-video {
		width: 100vh;
		height: 100%;
	}
	
	.images-container{
		    display: flex;
		    align-items: center;
		    justify-content: center;
	}

	.media-image,
	.media-video {
		object-fit: cover;
		width: 100vh;
		height: 100%;
	}

	.video-container {
		width: 100%;
		height: 100%;
		position: relative;
	}

	.image-indicator {
		position: absolute;
		bottom: 40px;
		left: 0;
		right: 0;
		flex-direction: column;
		align-items: center;
		z-index: 5;
		padding-bottom: 12px;
	}

	.indicator-dots {
		flex-direction: row;
		align-items: center;
	}

	.indicator-dot {
		width: 8px;
		height: 8px;
		border-radius: 4px;
		background-color: rgba(255, 255, 255, 0.4);
		margin: 0 4px;
	}

	.indicator-dot.active {
		width: 24px;
		background-color: #fff;
	}

	.video-controls-overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 20;
	}

	.play-btn {
		position: absolute;
		top: 50%;
		left: 50%;
		margin-left: -60px;
		margin-top: -60px;
	}

	.mute-btn {
		position: absolute;
		right: 28px;
		bottom: 140px;
	}

	.video-progress-overlay {
		position: absolute;
		left: 24px;
		right: 24px;
		bottom: 40px;
	}

	.progress-bar-overlay {
		height: 4px;
		background-color: rgba(255, 255, 255, 0.3);
		border-radius: 2px;
		overflow: hidden;
		margin-bottom: 12px;
	}

	.progress-fill-overlay {
		height: 100%;
		background-color: #fff;
		border-radius: 2px;
	}

	.progress-time {
		flex-direction: row;
		justify-content: space-between;
		font-size: 20px;
		color: #fff;
	}

	.right-actions {
		position: absolute;
		right: 24px;
		bottom: 180px;
		z-index: 30;
		flex-direction: column;
		align-items: center;
	}

	.action-item {
		flex-direction: column;
		align-items: center;
		margin-bottom: 28px;
		color: #fff;
	}

	.action-icon {
		justify-content: center;
		align-items: center;
	}

	.action-icon.liked {
		color: #ff194a;
	}

	.action-count {
		margin-top: 8px;
		font-size: 20px;
		color: #fff;
	}

	.avatar-item {
		position: relative;
	}

	.avatar-img {
		width: 90rpx;
		height: 90rpx;
		border-radius: 44px;
		border-width: 3px;
		border-color: #fff;
		box-sizing: border-box;
	}

	.follow-btn {
		width: 90rpx;
		height: 90rpx;
		position: absolute;
		right: 0;
		bottom: -40rpx;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.bottom {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding-left: 32px;
		padding-right: 32px;
		z-index: 30;
		//background-color: rgba(0, 0, 0, 0.35);
	}

	.bottom-info {
		width: 100%;
		flex-direction: column;
		padding-top: 32px;
	}

	.location-info {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-bottom: 12px;
		background: rgba(0, 0, 0, 0.55);
		padding: 13rpx;
		border-radius: 12rpx;

	}

	.location-text {
		font-size: 22rpx;
		margin-left: 6px;
		color: #fff;
	}

	.user-info {
		flex-direction: row;
		align-items: center;
		margin-bottom: 12px;
	}

	.username {
		font-size: 36rpx;
		color: #fff;
		font-weight: 600;
		margin-right: 12px;
	}

	.time {
		font-size: 20px;
		color: rgba(255, 255, 255, 0.8);
	}

	.description {
		font-size: 28rpx;
		color: #fff;
		line-height: 1.6;
	}

	.desc-text {
		opacity: 0.95;
		color: #fff;
	}

	.desc-text.expanded {
		flex-wrap: wrap;
	}

	.expand-btn {
		color: rgba(255, 255, 255, 0.9);
		font-size: 20px;
		margin-left: 8px;
		flex-direction: row;
		align-items: center;
	}
</style>