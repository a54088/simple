						userAvatar: 'https://aquan-test.oss-cn-hangzhou.aliyuncs.com/aquan/Image6.JPG',
						username: '用户C',
						time: '3天前',
						location: '虚拟空间',
						description: '这是一个有趣的视频内容，展示了数字世界的奇妙。',
						isExpanded: false,
						isLiked: false,
						likeCount: 890000,
