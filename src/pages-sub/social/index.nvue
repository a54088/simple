				</view>
				<view class="tabs">
					<view class="tab-item" :class="{ 'tab-active': currentTab === 0 }" @click="switchTab(0)">
						落地圈
					</view>
					<view class="tab-item" :class="{ 'tab-active': currentTab === 1 }" @click="switchTab(1)">
						社会圈
					</view>
				</view>
			</view>
		</view>

		<!-- 引入图片和视频组件 -->
		<view class="feed-wrapper" :style="{ paddingTop: (statusBarHeight + 96) + 'px' }">
			<ImgAndVideo :feedList="feedList" />
		</view>
	</view>
</template>

<script>
