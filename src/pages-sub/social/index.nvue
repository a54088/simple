		background-color: rgba(0, 0, 0, 0.45);
		border-radius: 26px;
		padding: 4px;
		width: 240px;
	}

	.tab-item {
		flex: 1;
		font-size: 16px;
		color: #fff;
		padding-top: 8px;
		padding-bottom: 8px;
		text-align: center;
		border-radius: 22px;
		font-weight: 500;
	}

	.tab-item.tab-active {
		background-color: rgba(255, 255, 255, 0.18);
		font-weight: 600;
	}

	.feed-wrapper {
		flex: 1;
	}
</style>