</script>

<style scoped>
	.social-page {
		background-color: #000;
	}

	.header {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		z-index: 10;
		background-color: transparent;
	}

	.header-nav {
		height: 72px;
		flex-direction: row;
