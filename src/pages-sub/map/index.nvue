<template>
  <view class="map_container" :style="{ height: screenHeightRpx + 'rpx' }">
    <map 
      id="mapComponent"
      ref="mapRef" 
      class="map_component"
      :style="{ height: screenHeightRpx + 'rpx' }"
      :markers="markers" 
      :latitude="currentLatitude" 
      :longitude="currentLongitude"
      :polygons="polygons"
      :circles="circles"
      @markertap="handleMarkerTap" 
      @updated="handleMapUpdated"
      :show-location="true"
      :enable-rotate="true"
    >
      <cover-image src="/static/map/mapBackground.png" style="height: 329px;"></cover-image>
      <!-- 自定义定位按钮 -->
      <cover-view class="location-btn" @tap="moveToCurrentLocation">
        <cover-image src="/static/map/position.png" mode="aspectFit" class="location-btn-image"></cover-image>
      </cover-view>
    </map>
    <MapHeader class="header_wrap" />
    <MapSide @iconClick="handleIconClick" />
    <MapFooter class="footer_wrap" />

    <AddFriend 
      :visible="popupShow" 
      title="不会捏蛋" 
      desc="已持续和28位用户交流" 
      :avatars="userAvatars" 
      buttonText="+ 添加好友"
      @close="popupShow = false" 
      @action="handleAddFriend"
    />

    <NearbyPopup 
        :visible="nearbyPopupShow"
        @close="nearbyPopupShow = false"
        @action="handleNearbyPopupShow"
    />

    <NameCardModel 
      :visible="nameCardPopupShow"
      @close="nameCardPopupShow = false"
      @action="handleNameCardPopupShow"
    />
  </view>
</template>

<script setup>
import { ref, onMounted, nextTick } from "vue";
import { useMap } from './hooks/useMap';
import MapHeader from './components/MapHeader/index.nvue';
import MapFooter from './components/MapFooter/index.nvue';
import MapSide from './components/MapSide/index.nvue';
import AddFriend from './components/AddFriend/index.nvue';
import NearbyPopup from './components/NearbyPopup/index.nvue';
import NameCardModel from './components/NameCardModel/index.nvue';
// 获取屏幕高度
const systemInfo = uni.getSystemInfoSync();
const screenHeight = systemInfo.windowHeight;
const screenHeightRpx = (screenHeight / systemInfo.windowWidth) * 750;

/* ==================== 地图 start ==================== */
/**
 * 获取map 上下文 mapContext 对象
 * https://uniapp.dcloud.net.cn/api/location/map.html
 */
const mapContext = uni.createMapContext('mapComponent');
// 地图实例引用
const mapRef = ref(null);
// 初始化地图钩子
const { markers, currentLatitude, currentLongitude, initMap } = useMap();

// 多边形图形数据
const polygons = ref([
  {
    points: [{ latitude: 39.909, longitude: 116.39742 }, { latitude: 39.9, longitude: 116.39 }, { latitude: 39.915, longitude: 116.405 }],
    strokeColor: '#000',
    fillColor:'#16c5ff1a',
    strokeWidth: 2
  },
  {
    points: [{ latitude: 30.287755, longitude: 120.191172 }, { latitude: 30.297755, longitude: 120.101172 }, { latitude: 30.309955, longitude: 120.291172 }],
    strokeColor: '#000',
    fillColor:'#16c5ff1a',
    strokeWidth: 2,
  }
]);

// 圆形
const circles = ref([
    {
        latitude: currentLatitude,
        longitude: currentLongitude,
        radius: 500,
        fillColor: '#16c5ff1a',
        strokeWidth: 2,
        color: '#16C5FF',
    }
]);
// 地图更新事件处理
const handleMapUpdated = () => {
  console.log('地图已更新');
};

// 获取当前位置并移动地图
const moveToCurrentLocation = () => {
  initMap(mapRef.value);
};


const handleIconClick = (item) => {
  mapContext.openMapApp({
    latitude: 30.250796,
    longitude: 120.140141,
    destination: '浙江省杭州市西湖区孤山路',
  });

  // mapContext.poiSearchNearBy({
  //   point: {
  //     latitude: currentLatitude,
  //     longitude: currentLongitude,
  //   },
  //   key: '网吧',
  //   radius: 500,
  //   index: 1,
  //   offset: 10
  // })
}

onMounted(() => {
  // 自定义指示图标
  mapContext.setLocMarkerIcon({
    iconPath: '/static/logo.png'
    // iconPath: '/static/images/map/zhishi.png'
  })
});
/* ==================== 地图 end ==================== */


/* ==================== 附近的内容 start ==================== */
const nearbyPopupShow = ref(false);

const handleNearbyPopupShow = () => {
    nearbyPopupShow.value = true;
}
/* ==================== 附近的内容 end ==================== */

/* ==================== 个人名片 start ==================== */
const nameCardPopupShow = ref(false);

const handleNameCardPopupShow = () => {
    nameCardPopupShow.value = true;
}
/* ==================== 个人名片 end ==================== */

//展示弹框
const popupShow = ref(false);
const userAvatars = ref([
  '/static/map/avatar1.webp',
  '/static/map/avatar2.webp',
  '/static/map/avatar3.webp',
  '/static/map/avatar4.webp',
  '/static/map/avatar5.webp',
]);

// handleMarkerTap
const handleMarkerTap = (e) => {
  const markerId = e.detail.markerId;
  const clickedMarker = markers.value.find(marker => marker.id === markerId);
//   popupShow.value = true;
  // nearbyPopupShow.value = true;
  nameCardPopupShow.value = true;
  console.log('弹框显示:', popupShow.value);
}

// 添加好友
const handleAddFriend = (e) => {
  // 处理添加好友逻辑
}

onMounted(() => {
  // 等待组件渲染完成后再获取地图实例
  nextTick(() => {
    // 延迟初始化，确保 map 组件完全加载
    setTimeout(() => {
      if (mapRef.value) {
        initMap(mapRef.value);
      } else {
        console.warn('地图引用未找到，重试初始化');
        setTimeout(() => {
          if (mapRef.value) {
            initMap(mapRef.value);
          }
        }, 300);
      }
    }, 300);
  });
});
</script>

<style lang="scss" scoped>
.map_container {
  width: 750rpx;
  position: relative;
  margin-top: 0;
  margin-bottom: 0;
  margin-left: 0;
  margin-right: 0;
  padding-top: 0;
  padding-bottom: 0;
  padding-left: 0;
  padding-right: 0;
  display: flex;
  flex-direction: column;
  background-color: transparent;
}

.overlay_container {
  position: absolute;
  top: 0;
  left: 0;
  width: 750rpx;
  background-color: transparent;
}

.map_component {
  position: absolute;
  top: 0;
  left: 0;
  width: 750rpx;
}

.location-btn {
  position: absolute;
  bottom: 340rpx;
  left: 40rpx;
  width: 96rpx;
  height: 96rpx;
  background-color: rgba(0, 0, 0, 0.5);
  padding: 24rpx;
  border-radius: 25rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  .location-btn-image {
    width: 48rpx;
    height: 48rpx;
  }
}
</style>
