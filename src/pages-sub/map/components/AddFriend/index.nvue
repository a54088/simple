<template>
  <!-- 弹框容器：通过 shouldRender 控制显示 -->
  <view v-if="shouldRender" class="map-popup">
    <!-- 遮罩层（可选，点击关闭弹框） -->
    <view :class="['popup-mask', { 'popup-mask-show': isShow }]" @tap="handleClose"></view>
    <!-- 弹框顶部操作内容 -->

    <!-- <u-icon name="search"></u-icon> -->

    <!-- 弹框主体 -->
    <view class="popup-content" :style="{ transform: `translateY(${isShow ? 0 : screenHeightPx}px)` }">
      <!-- 头部信息 -->
      <view class="popup-header">
        <view>
          <view class="popup-header-icons">
            <view class="popup-header-icons-item" @tap="handleClose">
              <image src="/static/images/map/icon-down.png" mode="widthFix" class="icon"></image>
            </view>
            <view class="popup-header-icons-item">
              <image src="/static/images/map/icon-search.png" mode="widthFix" class="icon"></image>
            </view>
          </view>
          <view>
            <text class="title">{{ title }}</text>
            <text class="desc">{{ desc }}</text>
          </view>
        </view>
        <image src="/static/images/map/addFriendsImg.webp" mode="widthFix" class="add-friends-img"></image>
      </view>
      <!-- 添加好友 -->
      <view class="add">
        <image src="/static/images/map/userCommunication.webp" mode="widthFix" class="avatar-imgs"></image>
        <!-- 操作按钮 -->
        <view class="action-btn" @tap="handleAction">
          <text class="action-btn-plus">+</text>
          <text class="action-btn-text">添加好友</text>
        </view>
      </view>
      <MapFooter></MapFooter>
    </view>
  </view>
</template>

<script setup>
import { ref, watch, nextTick, defineProps, defineEmits } from 'vue';
import MapFooter from '../MapFooter/index.nvue'

// 定义组件属性
const props = defineProps({
  // 是否显示弹框
  visible: {
    type: Boolean,
    default: false
  },
  // 标题文本
  title: {
    type: String,
    default: '用户名称'
  },
  // 描述文本
  desc: {
    type: String,
    default: '已持续和28位用户交流'
  },
  // 头像列表（最多显示5个）
  avatars: {
    type: Array,
    default: () => []
  },
});

const emit = defineEmits(['close', 'action']);

// 获取屏幕高度（px）
const systemInfo = uni.getSystemInfoSync();
const screenHeightPx = systemInfo.windowHeight;

// 控制元素是否渲染
const shouldRender = ref(false);
// 控制动画状态
const isShow = ref(false);

// 动画
watch(() => props.visible, (newVal) => {
  if (newVal) {
    // 显示时：先渲染元素，然后触发进入动画
    shouldRender.value = true;
    isShow.value = false;
    nextTick(() => {
      // 延迟一帧，确保初始状态已渲染
      setTimeout(() => {
        isShow.value = true;
      }, 50);
    });
  } else {
    // 隐藏时：先触发退出动画，动画完成后移除元素
    isShow.value = false;
    setTimeout(() => {
      shouldRender.value = false;
    }, 200);
  }
}, { immediate: true });

// 关闭弹框
const handleClose = () => {
  emit('close');
};

// 操作按钮点击事件
const handleAction = () => {
  emit('action');
};

// import { computed } from 'vue';
// // 定义每个头像的位置、尺寸配置（可根据设计调整）
// const avatarConfigs = [
//   { top: '50rpx', left: `calc(50% - 64rpx)`, width: '128rpx', height: '128rpx' },
//   { top: '100rpx', left: `calc(50% - 200rpx)`, width: '94rpx', height: '94rpx' },
//   { top: '20rpx', left: `calc(50% - 140rpx)`, width: '70rpx', height: '70rpx' },
//   { top: '0rpx', left: '360rpx', width: '102rpx', height: '102rpx' },
//   { top: '50rpx', left: '450rpx', width: '95rpx', height: '95rpx' },
//   // 若有更多头像，继续添加配置...
// ];

// // 计算每个头像的 top、left、width、height
// const getAvatarTop = (index) => avatarConfigs[index]?.top || '0rpx';
// const getAvatarLeft = (index) => avatarConfigs[index]?.left || '0rpx';
// const getAvatarWidth = (index) => avatarConfigs[index]?.width || '80rpx';
// const getAvatarHeight = (index) => avatarConfigs[index]?.height || '80rpx';

</script>

<style lang="scss" scoped>
.map-popup {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  background-color: transparent;
}

/* 遮罩层 */
.popup-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0);
  transition-property: background-color;
  transition-duration: 200ms;
  transition-timing-function: ease-out;
}

.popup-mask-show {
  background-color: rgba(0, 0, 0, 0.3);
}

/* 弹框内容 */
.popup-content {
  position: relative;
  width: 750rpx;
  background-color: #1a1a1a;
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
  padding-top: 40rpx;
  padding-bottom: 40rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  display: flex;
  flex-direction: column;
  transition-property: transform;
  transition-duration: 200ms;
  transition-timing-function: ease-out;

  /* 头部信息 */
  .popup-header {
    margin-bottom: 30rpx;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;

    .popup-header-icons {
      display: flex;
      flex-direction: row;
      margin-bottom: 40rpx;

      .popup-header-icons-item {
        width: 72rpx;
        height: 72rpx;
        border-radius: 105rpx;
        background-color: #1F1F1F;
        border-width: 1px;
        border-style: solid;
        border-color: #3D3D3D;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        margin-right: 30rpx;

        .icon {
          width: 32rpx;
          height: 32rpx;
        }
      }
    }

    .title {
      font-size: 50rpx;
      font-weight: 600;
      color: #ffffff;
      lines: 1;
    }

    .desc {
      font-size: 32rpx;
      color: #DCDCDC;
      margin-top: 10rpx;
      lines: 1;
    }

    .add-friends-img {
      width: 225rpx;
      height: 248rpx;
    }
  }

  /* 头像列表 */
  .add {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 240rpx;
    border-radius: 20rpx;
    overflow: hidden;
    border-width: 2rpx;
    border-style: solid;
    border-color: #3D3D3D;
    padding-top: 28rpx;
    padding-bottom: 32rpx;
    padding-left: 10rpx;
    padding-right: 10rpx;
    background-color: transparent;

    .avatar-imgs {
      width: 380rpx;
      height: 200rpx;
      margin-bottom: 34rpx;
    }

    /* 操作按钮 */
    .action-btn {
      width: 240rpx;
      height: 72rpx;
      border-radius: 168rpx;
      background-color: #39393B;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
    }

    .action-btn-plus {
      font-size: 40rpx;
      color: #ffffff;
      margin-right: 10rpx;
    }

    .action-btn-text {
      font-size: 32rpx;
      color: #ffffff;
    }
  }
}

/* 关闭按钮 */
.close-btn {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.1);
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.close-icon {
  color: #ffffff;
  font-size: 30rpx;
