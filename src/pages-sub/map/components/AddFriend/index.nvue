<!-- components/AddFriend/index.vue -->
<template>
  <view class="popup-container" :class="{ 'show': visible }">
    <!-- 遮罩层 -->
    <view class="mask" @click="emit('close')" :class="{ 'mask-show': visible }"></view>
    
    <!-- 弹框内容 -->
    <view class="popup-content" :class="{ 'content-show': visible }">
      <view class="popup-header">
        <text class="title">{{ title }}</text>
        <text class="close-btn" @click="emit('close')">×</text>
      </view>
      
      <view class="popup-body">
        <text class="desc">{{ desc }}</text>
        
        <view class="avatars">
          <view class="avatar-item" v-for="(item, index) in avatars" :key="index">
            <image :src="item" mode="aspectFill"></image>
          </view>
        </view>
      </view>
      
      <view class="popup-footer">
        <button class="action-btn" @click="emit('action')">{{ buttonText }}</button>
      </view>
    </view>
  </view>
</template>

<script setup>
import { defineProps, defineEmits } from 'vue'

const props = defineProps({
  visible: {
    type: Boolean,
    default: false
  },
  title: {
    type: String,
    default: ''
  },
  desc: {
    type: String,
    default: ''
  },
  avatars: {
    type: Array,
    default: () => []
  },
  buttonText: {
    type: String,
    default: ''
  }
})

const emit = defineEmits(['close', 'action'])
</script>

