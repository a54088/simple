<template>
  <!-- 弹框容器：通过 shouldRender 控制显示 -->
  <view v-if="shouldRender" class="name-card-model">
    <!-- 弹框主体 -->
    <view class="model-content" :style="{ transform: `translateX(${isShow ? 0 : -680}rpx)`, opacity: `${isShow ? 1 : 0}` }">
      <view @click="handleClose" class="close-box">
        <image class="close-btn" src="/static/images/common/white-close.png" mode="aspectFill"></image>
      </view>
      <view class="model-content-body">
        <view class="flex-row model-content-body-header">
          <view class="left-box flex-row">
            <view class="avatar-box">
              <image class="avatar-img" src="https://p26-passport.byteacctimg.com/img/user-avatar/60225805f9c3509ee8cb69a96d65e2a9~40x40.awebp" mode="aspectFill"></image>
            </view>
            <view class="left-box-content">
              <text class="name-text">泡泡大人</text>
              <text class="desc-text">杭州市·天蝎座</text>
            </view>
          </view>
          <view class="action-box">
            <text class="action-text">关注</text>
          </view>
        </view>
        <!-- 内容 -->
        <view class="model-content-body-content">
          <view class="content-tag flex-row">
            <text class="tag-text" v-for="item in 4" :key="item">标签{{ item }}</text>
          </view>
          <view class="content-footer flex-row">
            <view class="content-footer-img-box">
              <image class="content-footer-img" src="/static/images/map/add-firend.png" mode="aspectFill"></image>
            </view>
            <view class="content-footer-text-box">
              <text class="text">与分身对话</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup>
import { ref, watch, nextTick, defineProps, defineEmits } from 'vue';

// 定义组件属性
const props = defineProps({
  // 是否显示弹框
  visible: {
    type: Boolean,
    default: false
  },
  // 标题文本
  title: {
    type: String,
    default: '用户名称'
  },
  // 描述文本
  desc: {
    type: String,
    default: '已持续和28位用户交流'
  },
  // 头像列表（最多显示5个）
  avatars: {
    type: Array,
    default: () => []
  },
});

const emit = defineEmits(['close', 'action']);

// 获取屏幕高度（px）
const systemInfo = uni.getSystemInfoSync();
const screenHeightPx = systemInfo.windowHeight;

// 控制元素是否渲染
const shouldRender = ref(false);
// 控制动画状态
const isShow = ref(false);

// 动画
watch(() => props.visible, (newVal) => {
  if (newVal) {
    // 显示时：先渲染元素，然后触发进入动画
    shouldRender.value = true;
    isShow.value = false;
    nextTick(() => {
      // 延迟一帧，确保初始状态已渲染
      setTimeout(() => {
        isShow.value = true;
      }, 50);
    });
  } else {
    // 隐藏时：先触发退出动画，动画完成后移除元素
    isShow.value = false;
    setTimeout(() => {
      shouldRender.value = false;
    }, 200);
  }
}, { immediate: true });

// 关闭弹框
const handleClose = () => {
  emit('close');
};

// 操作按钮点击事件
const handleAction = () => {
  emit('action');
};

const handleNearbyShops = () => {
  uni.navigateTo({
    url: '/pages-sub/map/nearbyShops'
  });
};
</script>

